firmware/**/*.pio/
firmware/**/.pio/
*.hex
*.bin
*.elf

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*~

# Word temp files
~$*.docx
~$*.doc

# Simulation build
simulation/.next/
simulation/out/
